{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/routine-pusher-frontend",
  "redirects": [
    { "source": "/", "destination": "/lembretes/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/lembretes", "destination": "/lembretes/index.html" },
    { "source": "/lembretes/:path*", "destination": "/lembretes/index.html" }
  ]
}
