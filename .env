# Endereço de produção do routine-pusher-backend
# (https://github.com/gustavo-olmos/routine-pusher-backend).
#
# Lido no build por scripts/build.mjs e embutido no bundle: qualquer visitante
# enxerga este valor, então aqui só entra o que já é público — nunca segredo.
# Uma variável de ambiente com o mesmo nome vence este arquivo (é assim que a
# Vercel sobrepõe sem editar nada).
#
# Em localhost o front ignora isto e usa http://localhost:8080: o cookie de
# sessão é SameSite=Lax e não viaja de localhost para a API publicada.
API_URL=https://api.rotafin.com.br
